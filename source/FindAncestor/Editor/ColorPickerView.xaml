<Window x:Class="FindAncestor.Editor.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="420"
        Title="色の編集"
        Background="#F0F0F0">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 🎨 カラーボックス -->
        <Canvas x:Name="ColorArea"
                Width="260" Height="260"
                MouseDown="ColorArea_Mouse"
                MouseMove="ColorArea_Mouse">
            <Rectangle Width="260" Height="260">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Red" Offset="0"/>
                        <GradientStop Color="Yellow" Offset="0.17"/>
                        <GradientStop Color="Lime" Offset="0.33"/>
                        <GradientStop Color="Cyan" Offset="0.5"/>
                        <GradientStop Color="Blue" Offset="0.67"/>
                        <GradientStop Color="Magenta" Offset="0.83"/>
                        <GradientStop Color="Red" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 白グラデ -->
            <Rectangle Width="260" Height="260">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- カーソル -->
            <Ellipse x:Name="Cursor"
                     Width="10" Height="10"
                     Stroke="White" StrokeThickness="2"/>
        </Canvas>

        <!-- 🎚 Hueスライダー -->
        <Slider Grid.Column="1"
                x:Name="HueSlider"
                Orientation="Vertical"
                Minimum="0" Maximum="360"
                ValueChanged="HueChanged"/>

        <!-- 🎛 右パネル -->
        <StackPanel Grid.Column="2" Margin="10">

            <!-- プレビュー -->
            <Border Height="40" Background="{Binding SelectedBrush}" Margin="0,0,0,10"/>

            <!-- HEX -->
            <TextBox Text="{Binding Hex, Mode=OneWay}" IsReadOnly="True"/>

            <!-- RGB -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="R"/>
                <TextBox Width="40" Text="{Binding R, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="G"/>
                <TextBox Width="40" Text="{Binding G, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="B"/>
                <TextBox Width="40" Text="{Binding B, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <Button Content="OK" Click="Ok_Click" Margin="0,10,0,0"/>
        </StackPanel>

    </Grid>
</Window>