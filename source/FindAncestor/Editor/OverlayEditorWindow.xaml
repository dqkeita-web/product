<Window x:Class="FindAncestor.Editor.OverlayEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Editor"
        Width="400" Height="600"
        Background="#1E1E1E">

    <ScrollViewer>
        <StackPanel Margin="10">

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Background="#2A2A2A"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,0,0,10">

                            <StackPanel>

                                <!-- ヘッダ -->
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsVisible}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" Foreground="White"/>
                                    <Button Content="+"
                                            Margin="10,0,0,0"
                                            Click="AddItem_Click"/>
                                </StackPanel>

                                <!-- アイテム -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal" Margin="0,4">

                                                <!-- テキスト -->
                                                <TextBox Width="180"
                                                         Text="{Binding Text, Mode=TwoWay}"
                                                         Foreground="{Binding Foreground}"
                                                         GotFocus="Item_Focus"/>

                                                <!-- 削除 -->
                                                <Button Content="×"
                                                        Margin="4,0,0,0"
                                                        Click="RemoveItem_Click"/>

                                                <!-- 表示ON/OFF -->
                                                <CheckBox Margin="6,0,0,0"
                                                          IsChecked="{Binding IsVisible}"/>

                                                <!-- 🎨 カラーボタン -->
                                                <Button Content="🎨"
                                                        Margin="6,0,0,0"
                                                        Tag="{Binding}"
                                                        Click="ColorPicker_Click"/>

                                            </StackPanel>

                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Window>