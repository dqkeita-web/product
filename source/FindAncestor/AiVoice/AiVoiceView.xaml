<Window
    x:Class="FindAncestor.AiVoice.AiVoiceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:FindAncestor.AiVoice.ViewModels"
    Title="AI Voice"
    Width="300"
    Height="200"
    Background="#111">
    <Window.DataContext>
        <vm:AiVoiceViewModel />
    </Window.DataContext>
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button
                Width="120"
                Height="40"
                Margin="0,0,0,10"
                Command="{Binding ToggleRecordingCommand}"
                Content="録音" />
            <TextBlock
                Width="200"
                FontSize="14"
                Foreground="White"
                Text="{Binding ResultText}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>