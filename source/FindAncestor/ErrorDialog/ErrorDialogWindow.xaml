<Window x:Class="FindAncestor.ErrorDialog.ErrorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="エラー"
        Width="500"
        Height="300"
        WindowStartupLocation="CenterScreen"
        Background="#111"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Border Background="#222" CornerRadius="12" Padding="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- エラー内容 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Message}"
                           Foreground="White"
                           TextWrapping="Wrap"/>
            </ScrollViewer>

            <!-- ボタン -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">

                <!-- コピー -->
                <Button Width="48"
                        Height="48"
                        Margin="4"
                        FontFamily="Segoe MDL2 Assets"
                        Content="" 
                        Click="OnCopy"
                        ToolTip="コピー"/>

                <!-- 閉じる -->
                <Button Width="48"
                        Height="48"
                        Margin="4"
                        FontFamily="Segoe MDL2 Assets"
                        Content=""  
                        Click="OnClose"
                        ToolTip="閉じる"/>

            </StackPanel>

        </Grid>
    </Border>
</Window>