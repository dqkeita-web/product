<Window x:Class="FindAncestor.ErrorDialog.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#AA000000"
        Width="420"
        Height="240">

    <Border Background="#FF1E1E1E" CornerRadius="12" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- タイトル -->
            <TextBlock Text="エラー"
                       FontSize="20"
                       Foreground="White"
                       Margin="0,0,0,10"/>

            <!-- メッセージ -->
            <TextBox Grid.Row="1"
                     Text="{Binding Message}"
                     Foreground="White"
                     Background="#22000000"
                     BorderThickness="0"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <!-- ボタン -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">

                <Button Content="コピー"
                        Width="80"
                        Margin="0,0,8,0"
                        Click="OnCopy"
                        Style="{StaticResource AnimatedIconButton}"/>

                <Button Content="閉じる"
                        Width="80"
                        Click="OnClose"
                        Style="{StaticResource AnimatedIconButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>